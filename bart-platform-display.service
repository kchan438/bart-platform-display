[Unit]
Description=BART Platform Display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kevinchan
WorkingDirectory=/home/kevinchan/bart-platform-display
Environment=SDL_VIDEODRIVER=offscreen
Environment=SDL_AUDIODRIVER=dummy
ExecStart=/home/kevinchan/bart-platform-display/venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
