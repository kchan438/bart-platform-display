[Unit]
Description=BART Platform Display Boot Splash
After=local-fs.target systemd-modules-load.service
Before=bart-platform-display.service
ConditionPathExists=/home/kevinchan/bart-platform-display/deploy/splash/bart-splash.png

[Service]
Type=oneshot
User=kevinchan
WorkingDirectory=/home/kevinchan/bart-platform-display
Environment=SDL_VIDEODRIVER=offscreen
Environment=SDL_AUDIODRIVER=dummy
ExecStart=/home/kevinchan/bart-platform-display/venv/bin/python /home/kevinchan/bart-platform-display/deploy/splash/show_splash.py --image /home/kevinchan/bart-platform-display/deploy/splash/bart-splash.png --framebuffer /dev/fb0 --wait-seconds 15
RemainAfterExit=yes
TimeoutStartSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
